{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "hostUsers": {"type": "boolean"},
    "openshift": {
      "type": "object",
      "properties": {
        "privileged": {"type": "boolean"},
        "createSCC": {"type": "boolean"},
        "sccName": {"type": "string", "maxLength": 63, "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"}
      }
    },
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1},
    "runtime": {
      "type": "object",
      "properties": {
        "workerProcesses": {"type": "integer", "minimum": 1, "maximum": 256},
        "workerCPUPolicy": {"type": "string", "enum": ["logical", "physical"]},
        "restartBackoffSeconds": {"type": "integer", "minimum": 1},
        "shutdownTimeoutSeconds": {"type": "integer", "minimum": 1}
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "cpu": {"type": "integer", "minimum": 1},
        "memory": {"type": "string", "pattern": "^[1-9][0-9]*(Ki|Mi|Gi|Ti)$"}
      }
    },
    "udp": {
      "type": "object",
      "properties": {
        "port": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "reusePortDistribution": {"type": "string", "enum": ["hash", "rr"]},
        "balance": {"type": "string", "enum": ["roundrobin", "weight", "leastconn", "leastbandwidth", "iphash", "iphash1"]},
        "maxRequests": {"type": "integer", "minimum": 0},
        "maxResponses": {"type": "integer", "minimum": 0},
        "clientIdleTimeout": {"type": "string"},
        "backendIdleTimeout": {"type": "string"}
      }
    },
    "discovery": {
      "type": "object",
      "properties": {
        "kind": {"type": "string", "enum": ["srv", "static"]},
        "serviceName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "portName": {"type": "string", "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"},
        "staticList": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "srvLookupPattern": {"type": "string"}
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "probesEnabled": {"type": "boolean"},
        "port": {"type": "integer", "minimum": 1024, "maximum": 65535}
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "extraCapabilities": {"type": "array", "items": {"type": "string"}},
    "image": {
      "type": "object",
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    }
  }
}
